# Dependencies
node_modules/

# Expo
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# expo-router's typed routes are generated by `expo start` — not by `expo export`, not by
# `tsc`. Without them ESLint considers the assertion in `router.push(route as never)`
# unnecessary and reports an ERROR, so a fresh clone and CI would both be red while everything
# passes locally. That's why this one file is versioned. The pattern needs all four lines:
# git will not un-ignore a file that sits inside an ignored directory, so `!.expo/types/…`
# on its own would do nothing.
#
# After adding a screen under `app/`, run `make start` briefly and commit the refreshed file.
.expo/*
!.expo/types/
.expo/types/*
!.expo/types/router.d.ts

# Native projects are generated by `npx expo prebuild` from app.json — keeping them here
# would mean two sources of truth about the configuration. One command recreates them.
ios/
android/

# The content bundle. Lessons and questions belong to the course authors and must not be
# redistributed, so they are not in this repository — a separate, private tool builds them.
# A fresh clone passes `make check` but cannot build a runnable app. That is intentional.
assets/content/

# Preview sheet from the icon generator — a scratch render, recreated by `make icons`.
assets/ikona_celownik.png

# Signing keys and profiles. The Google Play upload key lives outside the repository;
# its location comes from the PATENT_UPLOAD_KEYSTORE environment variable.
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Native build artifacts and scratch files
.kotlin/
*.orig.*
*.log
npm-debug.*
.DS_Store

# Compiled Python from the icon generator
__pycache__/
*.pyc
